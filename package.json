{
  "name": "ijfk",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "seed:full": "node scripts/seed-full.mjs",
    "seed:clean": "node scripts/seed-full.mjs --clean",
    "hash-passwords": "node --import tsx scripts/hash-seed-passwords.ts",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:restart": "docker compose restart",
    "docker:rebuild": "docker compose up -d --build",
    "docker:tools": "docker compose --profile tools up -d",
    "docker:clean": "docker compose down -v --remove-orphans",
    "docker:shell:app": "docker compose exec app sh",
    "docker:shell:db": "docker compose exec db psql -U postgres -d ijfk",
    "docker:psql": "docker compose exec db psql -U postgres -d ijfk -c",
    "docker:reset": "docker compose down -v && docker compose up -d",
    "mail:test": "curl -s --user 'admin:admin' http://localhost:8025/api/v1/info"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@supabase/supabase-js": "^2.45.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "csv-parse": "^7.0.1",
    "lucide-react": "^1.14.0",
    "next": "16.2.4",
    "nodemailer": "^6.9.14",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "shadcn": "^4.6.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^6.4.16",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "pino-pretty": "^13.1.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
